{%- comment -%}
  MAISON DÉLICES - MAIN COLLECTION SECTION WITH FACETS & SORTING
{%- endcomment -%}

{{ 'collection-filters.js' | asset_url | script_tag_deferred }}

<section id="MainCollection-{{ section.id }}" class="section-spacing bg-cream">
  
  <!-- Breadcrumbs -->
  <div class="mb-4">
    {%- render 'breadcrumbs' -%}
  </div>

  <div class="container">
    
    <!-- Collection Banner & Header -->
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-chocolate tracking-tight mb-3">
        {{ collection.title }}
      </h1>
      {%- if collection.description != blank -%}
        <div class="text-sm sm:text-base text-chocolate/75 leading-relaxed font-body">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    <!-- Mobile Filter Trigger & Counter Bar -->
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-warm-border lg:hidden">
      <button
        type="button"
        class="btn btn-secondary btn-sm flex items-center gap-2"
        data-toggle-filters
        aria-label="Filter products"
      >
        <span>Filters & Sort</span>
      </button>
      <span class="text-xs font-semibold text-chocolate/60" id="ProductCountMobile">
        {{ collection.products_count }} Treats Available
      </span>
    </div>

    <!-- Grid & Sidebar Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Desktop Sidebar Filters -->
      <aside class="hidden lg:block lg:col-span-3 bg-beige/30 p-6 rounded-xl border border-warm-border">
        {%- render 'facets', results: collection -%}
      </aside>

      <!-- Main Products Grid -->
      <div class="lg:col-span-9" id="ProductGridContainer">
        
        <div class="hidden lg:flex items-center justify-between pb-4 mb-6 border-b border-warm-border text-xs text-chocolate/60 font-semibold">
          <span id="ProductCount">{{ collection.products_count }} Handcrafted Treats</span>
          <span>Freshly Baked Every Morning</span>
        </div>

        {%- paginate collection.products by section.settings.products_per_page -%}
          {%- if collection.products.size == 0 -%}
            <div class="py-16 text-center">
              <p class="font-serif text-2xl text-chocolate mb-2">No treats match your active filters.</p>
              <p class="text-sm text-chocolate/70 mb-6">Try clearing some filter tags or search for other sweet goods.</p>
              <a href="{{ collection.url }}" class="btn btn-primary btn-sm">Reset All Filters</a>
            </div>
          {%- else -%}
            <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
              {%- for product in collection.products -%}
                <div>
                  {%- render 'product-card',
                    product: product,
                    show_secondary_image: true,
                    show_rating: true,
                    enable_quick_add: true
                  -%}
                </div>
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          {%- endif -%}
        {%- endpaginate -%}

      </div>

    </div>

  </div>

  <!-- Mobile Filter Slide-out Drawer -->
  <div id="FilterDrawerOverlay" class="fixed inset-0 bg-chocolate/50 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>
  <div
    id="FilterDrawer"
    class="fixed top-0 right-0 bottom-0 w-5/6 max-w-sm bg-cream z-50 transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col lg:hidden border-l border-warm-border"
    role="dialog"
    aria-modal="true"
    aria-label="Filter and sort products"
  >
    <div class="p-4 flex items-center justify-between border-b border-warm-border">
      <span class="font-serif text-lg font-bold text-chocolate">Filter & Sort</span>
      <button type="button" class="p-1 text-chocolate hover:text-accent" data-toggle-filters aria-label="Close filters">
        {%- render 'icon', name: 'close', class: 'w-5 h-5' -%}
      </button>
    </div>
    <div class="p-6 flex-grow overflow-y-auto">
      {%- render 'facets', results: collection -%}
    </div>
    <div class="p-4 border-t border-warm-border bg-beige">
      <button type="button" class="btn btn-primary btn-full btn-sm" data-toggle-filters>
        View Results
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 36,
      "step": 6,
      "default": 12,
      "label": "Products Per Page"
    }
  ]
}
{% endschema %}
