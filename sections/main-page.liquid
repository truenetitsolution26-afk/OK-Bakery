{%- comment -%}
  MAISON DÉLICES - STANDARD RICH TEXT PAGE TEMPLATE
{%- endcomment -%}

<section id="MainPage-{{ section.id }}" class="section-spacing bg-cream">
  
  <div class="mb-4">
    {%- render 'breadcrumbs' -%}
  </div>

  <div class="container">
    <div class="max-w-3xl mx-auto">
      
      <header class="text-center mb-10">
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-chocolate tracking-tight mb-4">
          {{ page.title }}
        </h1>
        <div class="w-12 h-0.5 bg-accent mx-auto"></div>
      </header>

      <div class="prose prose-chocolate max-w-none text-chocolate/85 leading-relaxed font-body text-base space-y-6">
        {{ page.content }}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Page",
  "settings": []
}
{% endschema %}
