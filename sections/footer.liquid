{%- comment -%}
  MAISON DÉLICES - GLOBAL FOOTER WITH NEWSLETTER, HOURS & LINKS
{%- endcomment -%}

<footer id="SiteFooter" class="bg-chocolate text-cream border-t border-chocolate/40 relative z-20">
  
  <!-- Newsletter & Brand Teaser Section -->
  <div class="border-b border-cream/10 py-12 lg:py-16">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-6">
          <span class="text-xs uppercase tracking-widest font-bold text-accent block mb-2 font-body">
            The Bakery Club
          </span>
          <h3 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold text-white tracking-tight">
            {{ section.settings.newsletter_title | default: 'Receive 10% Off Your First Fresh Batch' }}
          </h3>
          <p class="text-xs sm:text-sm text-cream/70 mt-2 max-w-md font-light">
            {{ section.settings.newsletter_subtext | default: 'Subscribe to receive weekend secret bake menus, seasonal cake releases, and VIP tasting invites.' }}
          </p>
        </div>

        <div class="lg:col-span-6">
          {%- form 'customer', id: 'FooterNewsletterForm', class: 'max-w-md lg:ml-auto' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            
            {%- if form.posted_successfully? -%}
              <div class="p-3.5 rounded-lg bg-accent/20 border border-accent text-cream text-xs">
                Merci! Check your inbox for your 10% welcome code.
              </div>
            {%- else -%}
              <div class="flex flex-col sm:flex-row gap-2">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="Enter your email address..."
                  required
                  class="w-full bg-cream/10 border border-cream/20 rounded-lg px-4 py-3 text-xs text-cream placeholder-cream/40 focus:outline-none focus:border-accent"
                >
                <button type="submit" class="btn btn-accent btn-md flex-shrink-0 font-bold whitespace-nowrap">
                  Subscribe
                </button>
              </div>
              <span class="text-[11px] text-cream/40 mt-2 block">
                Zero spam. Only warm artisan bakery updates. Unsubscribe anytime.
              </span>
            {%- endif -%}
          {%- endform -%}
        </div>

      </div>
    </div>
  </div>

  <!-- Main Footer Columns -->
  <div class="py-12 lg:py-16">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
        
        <!-- Brand & Mission Column -->
        <div class="lg:col-span-4 space-y-4">
          <span class="font-serif text-2xl font-bold text-white block">{{ shop.name }}</span>
          <span class="text-[10px] uppercase tracking-[0.25em] text-accent font-semibold block -mt-2 font-body">
            Artisan Boulangerie & Pâtisserie
          </span>
          <p class="text-xs text-cream/70 leading-relaxed font-light">
            Dedicated to traditional French slow-fermentation, 100% organic flours, and handcrafted celebration cakes made fresh every single morning.
          </p>
          <div class="pt-2 text-xs text-cream/80 space-y-1">
            <p>📍 {{ settings.store_address | default: '142 Bedford Avenue, Brooklyn, NY' }}</p>
            <p>📞 <a href="tel:{{ settings.store_phone }}" class="hover:text-accent">{{ settings.store_phone | default: '+1 (718) 555-0192' }}</a></p>
            <p>✉️ <a href="mailto:{{ settings.store_email }}" class="hover:text-accent">{{ settings.store_email | default: 'bonjour@maison-delices.com' }}</a></p>
          </div>
        </div>

        <!-- Quick Links Column -->
        <div class="lg:col-span-3">
          <h4 class="font-serif text-base font-bold text-white mb-4">Bakery Menu</h4>
          <ul class="space-y-2.5 text-xs text-cream/70 font-body">
            <li><a href="{{ routes.root_url }}collections/all" class="hover:text-accent transition-colors">All Fresh Baked Goods</a></li>
            <li><a href="{{ routes.root_url }}collections/all" class="hover:text-accent transition-colors">Artisan Sourdough Loaves</a></li>
            <li><a href="{{ routes.root_url }}collections/all" class="hover:text-accent transition-colors">French Viennoiseries & Croissants</a></li>
            <li><a href="{{ routes.root_url }}collections/all" class="hover:text-accent transition-colors">Signature Celebration Cakes</a></li>
            <li><a href="{{ routes.root_url }}collections/all" class="hover:text-accent transition-colors">Macarons & Sweet Petit Fours</a></li>
          </ul>
        </div>

        <!-- Customer Care Column -->
        <div class="lg:col-span-2">
          <h4 class="font-serif text-base font-bold text-white mb-4">Customer Care</h4>
          <ul class="space-y-2.5 text-xs text-cream/70 font-body">
            <li><a href="{{ routes.root_url }}pages/contact" class="hover:text-accent transition-colors">Custom Cake Consultations</a></li>
            <li><a href="{{ routes.root_url }}pages/about" class="hover:text-accent transition-colors">Our Artisan Story</a></li>
            <li><a href="{{ routes.root_url }}pages/contact" class="hover:text-accent transition-colors">Local Delivery & Pickup</a></li>
            <li><a href="{{ routes.root_url }}pages/contact" class="hover:text-accent transition-colors">Allergen Information</a></li>
            <li><a href="{{ routes.root_url }}pages/contact" class="hover:text-accent transition-colors">Contact Concierge</a></li>
          </ul>
        </div>

        <!-- Bakery Hours & Socials Column -->
        <div class="lg:col-span-3 space-y-4">
          <h4 class="font-serif text-base font-bold text-white mb-4">Baking Hours</h4>
          <div class="text-xs text-cream/70 space-y-1.5 font-light">
            <p><strong class="text-cream font-semibold">Mon – Fri:</strong> 7:00 AM – 6:00 PM</p>
            <p><strong class="text-cream font-semibold">Sat – Sun:</strong> 7:30 AM – 5:00 PM</p>
            <p class="text-accent text-[11px] font-semibold pt-1">Ovens fire at 3:00 AM daily</p>
          </div>

          {%- if section.settings.show_social -%}
            <div class="pt-3">
              <span class="text-[11px] uppercase tracking-wider font-bold text-cream/50 block mb-2 font-body">Follow Our Bakery</span>
              <div class="flex items-center gap-3 text-xs text-cream/80">
                <a href="{{ settings.social_instagram | default: '#' }}" target="_blank" rel="noopener" class="hover:text-accent transition-colors">Instagram</a>
                <span class="opacity-30">•</span>
                <a href="{{ settings.social_facebook | default: '#' }}" target="_blank" rel="noopener" class="hover:text-accent transition-colors">Facebook</a>
                <span class="opacity-30">•</span>
                <a href="{{ settings.social_pinterest | default: '#' }}" target="_blank" rel="noopener" class="hover:text-accent transition-colors">Pinterest</a>
              </div>
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom Legal & Payment Badges -->
  <div class="border-t border-cream/10 py-6 text-xs text-cream/50">
    <div class="container flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Handcrafted with organic passion. All rights reserved.
      </div>
      <div class="flex items-center gap-3 text-[11px]">
        <span>Privacy Policy</span>
        <span>•</span>
        <span>Terms of Service</span>
        <span>•</span>
        <span>Delivery Policy</span>
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Receive 10% Off Your First Fresh Batch"
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "Subscribe to receive weekend secret bake menus, seasonal cake releases, and VIP tasting invites."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Links",
      "default": true
    }
  ]
}
{% endschema %}
