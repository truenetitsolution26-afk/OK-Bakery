{%- comment -%}
  MAISON DÉLICES - PROMOTIONAL CELEBRATION BANNER
{%- endcomment -%}

<section id="PromoBanner-{{ section.id }}" class="section-spacing bg-chocolate text-cream relative overflow-hidden">
  
  <!-- Background Pattern / Image -->
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'w-full h-full object-cover', loading: 'lazy' }}
    {%- else -%}
      <img src="https://picsum.photos/seed/bakery_promo_treats/1800/800" alt="Bakery Treats" class="w-full h-full object-cover" width="1800" height="800" loading="lazy">
    {%- endif -%}
  </div>

  <div class="container relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      
      {%- if section.settings.badge != blank -%}
        <span class="inline-block px-3.5 py-1 rounded-full bg-accent text-white text-xs font-bold uppercase tracking-widest mb-6 shadow-md">
          {{ section.settings.badge }}
        </span>
      {%- endif -%}

      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight mb-6">
        {{ section.settings.heading }}
      </h2>

      <p class="text-base md:text-lg text-cream/80 font-light leading-relaxed mb-8 max-w-2xl mx-auto">
        {{ section.settings.description }}
      </p>

      {%- if section.settings.coupon_code != blank -%}
        <div class="inline-flex items-center gap-3 bg-cream/10 border border-cream/20 rounded-xl px-5 py-3 mb-8 backdrop-blur-sm">
          <span class="text-xs uppercase tracking-wider text-cream/70 font-semibold">Use promo code:</span>
          <span class="font-mono text-sm font-bold text-accent px-2.5 py-1 bg-cream/20 rounded border border-accent/40 tracking-wider">
            {{ section.settings.coupon_code }}
          </span>
        </div>
      {%- endif -%}

      <div class="flex justify-center">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn-accent btn-lg font-bold shadow-xl">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Texture / Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Promotion Badge",
      "default": "Weekend Celebration Special"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Sweet Treats For Every Special Celebration"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Planning a wedding, birthday, or festive brunch? Receive a complimentary box of Parisian macarons with any custom cake order over $80."
    },
    {
      "type": "text",
      "id": "coupon_code",
      "label": "Coupon Code (Optional)",
      "default": "BAKEDWITHLOVE"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA Button Label",
      "default": "Order Weekend Treats"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promotional Celebration Banner"
    }
  ]
}
{% endschema %}
