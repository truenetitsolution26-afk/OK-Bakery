{%- comment -%}
  MAISON DÉLICES - BAKERY CONTACT & CUSTOM CAKE INQUIRY FORM
{%- endcomment -%}

<section id="ContactForm-{{ section.id }}" class="section-spacing bg-cream">
  
  <div class="mb-4">
    {%- render 'breadcrumbs' -%}
  </div>

  <div class="container">
    <div class="max-w-4xl mx-auto">
      
      <!-- Section Header -->
      <div class="text-center mb-12">
        <span class="text-xs uppercase tracking-widest font-bold text-accent block mb-2 font-body">
          {{ section.settings.subheading | default: 'We Are At Your Service' }}
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-chocolate tracking-tight mb-4">
          {{ section.settings.heading | default: 'Get In Touch' }}
        </h1>
        <p class="text-sm sm:text-base text-chocolate/75 max-w-lg mx-auto">
          {{ section.settings.description | default: 'Have a question about custom cake design, wholesale orders, or dietary allergens? Our team is delighted to assist you.' }}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Contact Info & Bakery Hours -->
        <div class="lg:col-span-5 bg-beige/50 p-6 sm:p-8 rounded-2xl border border-warm-border space-y-6">
          
          <div>
            <h3 class="font-serif text-xl font-bold text-chocolate mb-2">The Boulangerie</h3>
            <p class="text-xs sm:text-sm text-chocolate/75 leading-relaxed">
              {{ settings.store_address | default: '142 Bedford Avenue, Brooklyn, NY 11249' }}
            </p>
          </div>

          <div class="border-t border-warm-border pt-4">
            <h4 class="font-serif text-base font-bold text-chocolate mb-1.5">Baking & Pickup Hours</h4>
            <ul class="text-xs sm:text-sm text-chocolate/75 space-y-1">
              <li class="flex justify-between">
                <span>Monday – Friday:</span>
                <span class="font-semibold text-chocolate">7:00 AM – 6:00 PM</span>
              </li>
              <li class="flex justify-between">
                <span>Saturday & Sunday:</span>
                <span class="font-semibold text-chocolate">7:30 AM – 5:00 PM</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-warm-border pt-4">
            <h4 class="font-serif text-base font-bold text-chocolate mb-1.5">Direct Line</h4>
            <p class="text-xs sm:text-sm text-chocolate/75">
              <a href="tel:{{ settings.store_phone }}" class="hover:text-accent font-semibold">
                {{ settings.store_phone | default: '+1 (718) 555-0192' }}
              </a>
            </p>
            <p class="text-xs text-chocolate/50 mt-1">
              For same-day cake emergencies or courier delivery dispatch.
            </p>
          </div>

        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-7 bg-cream p-6 sm:p-8 rounded-2xl border border-warm-border shadow-sm">
          {%- form 'contact', id: 'ContactForm' -%}
            
            {%- if form.posted_successfully? -%}
              <div class="p-4 mb-6 rounded-xl bg-accent/10 border border-accent text-chocolate text-sm">
                <p class="font-bold text-accent mb-1">Merci beaucoup!</p>
                <p>Your message has been received. Our head pastry concierge will respond within 24 hours.</p>
              </div>
            {%- elsif form.errors -%}
              <div class="p-4 mb-6 rounded-xl bg-sale/10 border border-sale text-sale text-sm">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="space-y-4">
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="ContactFormName" class="block text-xs uppercase tracking-wider font-bold text-chocolate mb-1 font-body">
                    Your Name *
                  </label>
                  <input
                    type="text"
                    name="contact[name]"
                    id="ContactFormName"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    required
                    class="w-full bg-cream border border-warm-border rounded-lg p-2.5 text-xs text-chocolate focus:outline-none focus:border-accent"
                    placeholder="Camille Laurent"
                  >
                </div>

                <div>
                  <label for="ContactFormEmail" class="block text-xs uppercase tracking-wider font-bold text-chocolate mb-1 font-body">
                    Email Address *
                  </label>
                  <input
                    type="email"
                    name="contact[email]"
                    id="ContactFormEmail"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    required
                    class="w-full bg-cream border border-warm-border rounded-lg p-2.5 text-xs text-chocolate focus:outline-none focus:border-accent"
                    placeholder="camille@example.com"
                  >
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="ContactFormPhone" class="block text-xs uppercase tracking-wider font-bold text-chocolate mb-1 font-body">
                    Phone Number
                  </label>
                  <input
                    type="tel"
                    name="contact[phone]"
                    id="ContactFormPhone"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    class="w-full bg-cream border border-warm-border rounded-lg p-2.5 text-xs text-chocolate focus:outline-none focus:border-accent"
                    placeholder="(555) 000-0000"
                  >
                </div>

                <div>
                  <label for="ContactFormSubject" class="block text-xs uppercase tracking-wider font-bold text-chocolate mb-1 font-body">
                    Inquiry Type
                  </label>
                  <select
                    name="contact[inquiry_type]"
                    id="ContactFormSubject"
                    class="w-full bg-cream border border-warm-border rounded-lg p-2.5 text-xs text-chocolate focus:outline-none focus:border-accent"
                  >
                    <option value="Custom Cake Consultation">Custom Cake Consultation</option>
                    <option value="Wedding Tasting Request">Wedding Tasting Request</option>
                    <option value="Wholesale & Corporate Catering">Wholesale & Corporate Catering</option>
                    <option value="Allergen & Ingredient Inquiry">Allergen & Ingredient Inquiry</option>
                    <option value="General Bakery Question">General Bakery Question</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="ContactFormMessage" class="block text-xs uppercase tracking-wider font-bold text-chocolate mb-1 font-body">
                  Message Details *
                </label>
                <textarea
                  name="contact[body]"
                  id="ContactFormMessage"
                  rows="4"
                  required
                  class="w-full bg-cream border border-warm-border rounded-lg p-3 text-xs text-chocolate focus:outline-none focus:border-accent"
                  placeholder="Share details such as event date, guest count, flavor preferences, or specific requests..."
                >{% if form.body %}{{ form.body }}{% endif %}</textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg btn-full font-bold shadow-md">
                Send Inquiry &rarr;
              </button>

            </div>

          {%- endform -%}
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact & Cake Inquiry",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We Are At Your Service"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Have a question about custom cake design, wholesale orders, or dietary allergens? Our team is delighted to assist you."
    }
  ],
  "presets": [
    {
      "name": "Contact Form Section"
    }
  ]
}
{% endschema %}
