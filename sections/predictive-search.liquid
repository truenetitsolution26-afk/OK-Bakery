{%- comment -%}
  MAISON DÉLICES - AJAX PREDICTIVE SEARCH RESPONSE TEMPLATE
{%- endcomment -%}

{%- if predictive_search.performed -%}
  <div id="predictive-search-results" class="bg-cream border border-warm-border rounded-xl shadow-2xl overflow-hidden max-h-[75vh] overflow-y-auto">
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="p-4 border-b border-warm-border bg-beige/50">
        <h3 class="font-serif text-sm font-bold text-chocolate uppercase tracking-wider">
          Suggested Baked Treats
        </h3>
      </div>
      <ul class="divide-y divide-warm-border" role="listbox">
        {%- for product in predictive_search.resources.products -%}
          <li class="hover:bg-beige transition-colors" role="option">
            <a href="{{ product.url }}" class="flex items-center gap-3.5 p-3">
              <div class="w-14 h-14 rounded-lg overflow-hidden bg-beige border border-warm-border flex-shrink-0">
                {%- if product.featured_media != blank -%}
                  {{ product.featured_media | image_url: width: 100 | image_tag: class: 'w-full h-full object-cover', alt: product.title, loading: 'lazy' }}
                {%- else -%}
                  <img src="https://picsum.photos/seed/psearch_{{ product.id }}/100/100" class="w-full h-full object-cover" width="100" height="100" alt="{{ product.title }}">
                {%- endif -%}
              </div>
              <div class="flex-grow min-w-0">
                <span class="font-serif text-sm font-bold text-chocolate truncate block">{{ product.title }}</span>
                <span class="text-xs font-semibold text-accent block mt-0.5">{{ product.price | money }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <div class="p-3 text-center bg-beige/30 border-t border-warm-border">
        <button
          type="submit"
          class="text-xs font-bold text-accent hover:text-accent-hover transition-colors font-body"
        >
          View all results for "{{ predictive_search.terms }}" &rarr;
        </button>
      </div>
    {%- else -%}
      <div class="p-6 text-center text-xs text-chocolate/70">
        No treats found matching "{{ predictive_search.terms }}".
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
