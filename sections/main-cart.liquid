{%- comment -%}
  MAISON DÉLICES - DEDICATED CART PAGE
{%- endcomment -%}

<section id="MainCart-{{ section.id }}" class="section-spacing bg-cream min-h-[60vh]">
  
  <div class="mb-4">
    {%- render 'breadcrumbs' -%}
  </div>

  <div class="container">
    
    <div class="max-w-4xl mx-auto">
      
      <div class="border-b border-warm-border pb-6 mb-8 text-center sm:text-left flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-chocolate tracking-tight">
          {{ 'cart.general.title' | t | default: 'Your Bakery Bag' }}
        </h1>
        <a href="{{ routes.root_url }}collections/all" class="text-xs font-bold text-accent hover:underline">
          &larr; Continue Shopping Treats
        </a>
      </div>

      {%- if cart.item_count == 0 -%}
        <div class="py-20 text-center bg-beige/30 rounded-2xl border border-warm-border p-8">
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-beige flex items-center justify-center text-chocolate/40">
            {%- render 'icon', name: 'cart', class: 'w-10 h-10' -%}
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl text-chocolate font-bold mb-3">Your shopping bag is empty</h2>
          <p class="text-sm text-chocolate/70 mb-8 max-w-md mx-auto">
            Fill your bag with handcrafted sourdough, buttery croissants, and bespoke celebration cakes.
          </p>
          <a href="{{ routes.root_url }}collections/all" class="btn btn-primary btn-lg">
            Browse All Fresh Baked Goods
          </a>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Line Items Table -->
          <div class="lg:col-span-8 space-y-4">
            
            <div class="hidden sm:grid grid-cols-12 text-xs uppercase tracking-wider font-bold text-chocolate/60 pb-3 border-b border-warm-border">
              <span class="col-span-7">Treat</span>
              <span class="col-span-2 text-center">Quantity</span>
              <span class="col-span-3 text-right">Total</span>
            </div>

            {%- for item in cart.items -%}
              <div class="py-4 border-b border-warm-border flex flex-col sm:grid sm:grid-cols-12 gap-4 items-center">
                
                <!-- Product Details -->
                <div class="col-span-7 flex items-center gap-4 w-full">
                  <div class="w-20 h-20 rounded-lg overflow-hidden bg-beige border border-warm-border flex-shrink-0">
                    {%- if item.image != blank -%}
                      {{ item.image | image_url: width: 200 | image_tag: class: 'w-full h-full object-cover', alt: item.title, loading: 'lazy' }}
                    {%- endif -%}
                  </div>
                  <div>
                    <h3 class="font-serif text-base sm:text-lg font-bold text-chocolate leading-snug">
                      <a href="{{ item.url }}" class="hover:text-accent">{{ item.product.title }}</a>
                    </h3>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="text-xs text-chocolate/60 mt-0.5">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <span class="text-xs font-semibold text-chocolate/70 block sm:hidden mt-1">{{ item.final_price | money }}</span>
                  </div>
                </div>

                <!-- Quantity Controls -->
                <div class="col-span-2 flex justify-center w-full sm:w-auto">
                  <div class="quantity-selector">
                    <button type="button" class="quantity-selector__btn" data-cart-qty-change="-1" data-line-key="{{ item.key }}" data-current-qty="{{ item.quantity }}">-</button>
                    <input
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      class="quantity-selector__input"
                      aria-label="Quantity for {{ item.title }}"
                    >
                    <button type="button" class="quantity-selector__btn" data-cart-qty-change="1" data-line-key="{{ item.key }}" data-current-qty="{{ item.quantity }}">+</button>
                  </div>
                </div>

                <!-- Line Total & Remove -->
                <div class="col-span-3 text-right flex sm:flex-col justify-between sm:justify-center items-end w-full sm:w-auto">
                  <span class="font-serif text-base sm:text-lg font-bold text-chocolate">
                    {{ item.final_line_price | money }}
                  </span>
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    class="text-xs text-chocolate/50 hover:text-sale underline mt-1"
                    data-cart-remove="{{ item.key }}"
                  >
                    Remove
                  </a>
                </div>

              </div>
            {%- endfor -%}

            <!-- Cart Note & Delivery Instructions -->
            <div class="pt-6">
              <label for="CartNote" class="block font-serif text-base font-bold text-chocolate mb-2">
                Order Notes & Custom Inscriptions
              </label>
              <textarea
                name="note"
                id="CartNote"
                rows="3"
                class="w-full bg-cream border border-warm-border rounded-xl p-3 text-xs text-chocolate placeholder-chocolate/40 focus:outline-none focus:border-accent"
                placeholder="Include custom cake lettering (e.g., 'Happy 30th Sophia!'), allergen alerts, or gate entry codes..."
              >{{ cart.note }}</textarea>
            </div>

          </div>

          <!-- Order Summary Card -->
          <div class="lg:col-span-4 bg-beige/40 p-6 sm:p-7 rounded-2xl border border-warm-border space-y-5">
            <h3 class="font-serif text-xl font-bold text-chocolate border-b border-warm-border pb-3">
              Order Summary
            </h3>

            <div class="flex items-center justify-between text-sm text-chocolate">
              <span>Subtotal</span>
              <span class="font-serif text-lg font-bold">{{ cart.total_price | money }}</span>
            </div>

            <div class="flex items-center justify-between text-xs text-chocolate/70">
              <span>Estimated Delivery</span>
              <span>Calculated at checkout</span>
            </div>

            <div class="border-t border-warm-border pt-4 flex items-center justify-between font-bold text-chocolate text-base">
              <span>Estimated Total</span>
              <span class="font-serif text-2xl text-accent">{{ cart.total_price | money }}</span>
            </div>

            <button
              type="submit"
              name="checkout"
              class="btn btn-primary btn-full btn-lg font-bold shadow-lg"
            >
              Proceed to Checkout &rarr;
            </button>

            <div class="pt-2 text-center text-xs text-chocolate/60 space-y-1">
              <p>🔒 256-bit Encrypted Checkout</p>
              <p>Freshness Guaranteed On Arrival</p>
            </div>
          </div>

        </form>
      {%- endif -%}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Main Cart Page",
  "settings": []
}
{% endschema %}
