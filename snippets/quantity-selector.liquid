{%- comment -%}
  MAISON DÉLICES - QUANTITY SELECTOR SNIPPET
  Accepts:
  - min: {Number}
  - name: {String}
  - value: {Number}
  - id: {String}
{%- endcomment -%}

<div class="quantity-selector">
  <button
    type="button"
    class="quantity-selector__btn"
    name="minus"
    aria-label="{{ 'products.product.quantity.decrease' | t | default: 'Decrease quantity' }}"
    onclick="const input = this.nextElementSibling; if (input.value > 1) { input.value--; input.dispatchEvent(new Event('change')); }"
  >
    &#8722;
  </button>
  
  <input
    type="number"
    name="{{ name | default: 'quantity' }}"
    id="{{ id | default: 'Quantity' }}"
    class="quantity-selector__input"
    min="{{ min | default: 1 }}"
    value="{{ value | default: 1 }}"
    aria-label="{{ 'products.product.quantity.input_label' | t | default: 'Quantity' }}"
  >

  <button
    type="button"
    class="quantity-selector__btn"
    name="plus"
    aria-label="{{ 'products.product.quantity.increase' | t | default: 'Increase quantity' }}"
    onclick="const input = this.previousElementSibling; input.value++; input.dispatchEvent(new Event('change'));"
  >
    &#43;
  </button>
</div>
