{%- comment -%}
  MAISON DÉLICES - REUSABLE PRODUCT CARD SNIPPET
  Accepts:
  - product: {Object} Product Liquid object
  - show_secondary_image: {Boolean}
  - show_vendor: {Boolean}
  - show_rating: {Boolean}
  - enable_quick_add: {Boolean}
  - media_aspect_ratio: {String} 'square' | 'portrait' | 'landscape'
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign aspect_ratio = media_aspect_ratio | default: settings.product_image_ratio | default: 'square' -%}

<div class="product-card group" data-product-id="{{ product.id }}">
  
  <!-- Media Wrapper with Hover Image & Badges -->
  <div class="product-card__media-wrapper {{ aspect_ratio }}">
    
    <!-- Status Badges -->
    <div class="product-card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t | default: 'Sold Out' }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge--sale">-{{ savings }}%</span>
      {%- endif -%}

      {%- if product.tags contains 'fresh-daily' or product.tags contains 'Fresh' -%}
        <span class="badge">Fresh Daily</span>
      {%- endif -%}
    </div>

    <!-- Product Links & Images -->
    <a href="{{ product.url }}" class="block w-full h-full" tabindex="-1">
      {%- if product.featured_media != blank -%}
        {{ product.featured_media | image_url: width: 700 | image_tag:
          class: 'product-card__image',
          alt: product.featured_media.alt | default: product.title,
          loading: 'lazy',
          widths: '300, 500, 700'
        }}

        {%- if show_secondary_image != false and product.media[1] != blank -%}
          {{ product.media[1] | image_url: width: 700 | image_tag:
            class: 'product-card__image-secondary',
            alt: product.media[1].alt | default: product.title,
            loading: 'lazy',
            widths: '300, 500, 700'
          }}
        {%- endif -%}
      {%- else -%}
        <img
          src="https://picsum.photos/seed/bakery_{{ product.id | default: 123 }}/600/600"
          alt="{{ product.title }}"
          class="product-card__image"
          width="600"
          height="600"
          loading="lazy"
        >
      {%- endif -%}
    </a>

    <!-- Quick Add to Cart Action Overlay -->
    {%- if enable_quick_add != false and product.available -%}
      <div class="product-card__quick-add">
        {%- if product.has_only_default_variant -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="w-full">
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button
              type="submit"
              name="add"
              class="btn btn-primary btn-sm btn-full shadow-lg"
              aria-label="{{ 'products.product.add_to_cart' | t }} - {{ product.title }}"
            >
              {%- render 'icon', name: 'cart', class: 'w-4 h-4 mr-1' -%}
              <span>Quick Add</span>
            </button>
          </form>
        {%- else -%}
          <a
            href="{{ product.url }}"
            class="btn btn-primary btn-sm btn-full shadow-lg"
            aria-label="Choose options for {{ product.title }}"
          >
            <span>Select Options</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <!-- Content & Pricing -->
  <div class="product-card__content">
    
    {%- if show_vendor and product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}">
        {{ product.title }}
      </a>
    </h3>

    {%- if show_rating != false -%}
      <div class="flex items-center gap-1 text-accent text-xs mb-2">
        {%- for i in (1..5) -%}
          {%- render 'icon', name: 'star', class: 'w-3 h-3' -%}
        {%- endfor -%}
        <span class="text-chocolate/60 text-[11px] ml-1 font-semibold">(5.0)</span>
      </div>
    {%- endif -%}

    <div class="mt-auto">
      {%- render 'price', product: product, price_class: 'text-sm sm:text-base' -%}
    </div>

  </div>

</div>
