{%- comment -%}
  MAISON DÉLICES - SEARCH MODAL POPUP & AJAX PREDICTOR
{%- endcomment -%}

<div
  id="SearchModalOverlay"
  class="fixed inset-0 bg-chocolate/60 backdrop-blur-md z-50 opacity-0 pointer-events-none transition-opacity duration-300 flex items-start justify-center pt-16 sm:pt-24 px-4"
  role="dialog"
  aria-modal="true"
  aria-label="Search Bakery Menu"
>
  <div
    id="SearchModalContainer"
    class="w-full max-w-2xl bg-cream border border-warm-border rounded-2xl shadow-2xl overflow-hidden transform -translate-y-4 transition-transform duration-300"
  >
    <!-- Header with Search Input & Close -->
    <div class="p-4 sm:p-5 border-b border-warm-border flex items-center gap-3">
      <div class="text-chocolate/60">
        {%- render 'icon', name: 'search', class: 'w-5 h-5' -%}
      </div>
      
      <form action="{{ routes.search_url }}" method="get" class="flex-grow">
        <input
          type="search"
          name="q"
          id="SearchModalInput"
          placeholder="Search breads, cakes, viennoiseries..."
          class="w-full bg-transparent font-serif text-lg sm:text-xl text-chocolate placeholder-chocolate/40 focus:outline-none"
          autocomplete="off"
          data-predictive-search-input
        >
      </form>

      <button
        type="button"
        class="p-2 text-chocolate/70 hover:text-chocolate rounded-full hover:bg-beige transition-colors"
        data-close-search-modal
        aria-label="Close search dialog"
      >
        {%- render 'icon', name: 'close', class: 'w-5 h-5' -%}
      </button>
    </div>

    <!-- Live Search Results or Quick Suggested Terms -->
    <div id="SearchModalResults" class="p-5 max-h-[60vh] overflow-y-auto">
      
      <div id="SearchModalDefaults">
        <span class="text-xs uppercase tracking-wider font-bold text-chocolate/50 block mb-3 font-body">
          Popular Daily Treats
        </span>
        <div class="flex flex-wrap gap-2">
          <a href="{{ routes.search_url }}?q=Croissant" class="px-3 py-1.5 rounded-full bg-beige border border-warm-border text-xs font-semibold text-chocolate hover:bg-caramel hover:text-white transition-colors">
            🥐 Butter Croissants
          </a>
          <a href="{{ routes.search_url }}?q=Sourdough" class="px-3 py-1.5 rounded-full bg-beige border border-warm-border text-xs font-semibold text-chocolate hover:bg-caramel hover:text-white transition-colors">
            🥖 Country Sourdough
          </a>
          <a href="{{ routes.search_url }}?q=Cake" class="px-3 py-1.5 rounded-full bg-beige border border-warm-border text-xs font-semibold text-chocolate hover:bg-caramel hover:text-white transition-colors">
            🎂 Custom Layer Cakes
          </a>
          <a href="{{ routes.search_url }}?q=Eclair" class="px-3 py-1.5 rounded-full bg-beige border border-warm-border text-xs font-semibold text-chocolate hover:bg-caramel hover:text-white transition-colors">
            🍫 Chocolate Éclairs
          </a>
        </div>
      </div>

      <div id="SearchPredictiveOutput" class="hidden"></div>
      
    </div>

  </div>
</div>
