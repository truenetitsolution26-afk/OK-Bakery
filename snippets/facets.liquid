{%- comment -%}
  MAISON DÉLICES - NATIVE STOREFRONT FACET FILTERING & SORTING
  Accepts:
  - results: {Object} Collection or Search object
{%- endcomment -%}

<form id="CollectionFiltersForm" class="facets-form">
  <!-- Desktop / Drawer Filters Wrapper -->
  <div class="space-y-6">
    
    <!-- Active Filters Pills -->
    {%- assign has_active_filters = false -%}
    {%- for filter in results.filters -%}
      {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_active_filters -%}
      <div class="flex flex-wrap items-center gap-2 pb-4 border-b border-warm-border">
        <span class="text-xs font-bold text-chocolate uppercase tracking-wider">Active:</span>
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <a
              href="{{ value.url_to_remove }}"
              class="inline-flex items-center gap-1.5 px-3 py-1 bg-beige text-chocolate text-xs rounded-full hover:bg-caramel hover:text-white transition-colors"
            >
              <span>{{ filter.label }}: {{ value.label }}</span>
              <span aria-hidden="true">&times;</span>
            </a>
          {%- endfor -%}
        {%- endfor -%}
        <a href="{{ results.url }}" class="text-xs text-accent underline font-semibold ml-2">Clear all</a>
      </div>
    {%- endif -%}

    <!-- Filter Groups -->
    {%- for filter in results.filters -%}
      <div class="border-b border-warm-border pb-5">
        <h4 class="font-serif text-base font-bold text-chocolate mb-3">
          {{ filter.label }}
        </h4>

        {%- case filter.type -%}
          {%- when 'boolean', 'list' -%}
            <div class="space-y-2 max-h-48 overflow-y-auto pr-2">
              {%- for value in filter.values -%}
                <label class="flex items-center gap-2.5 text-xs text-chocolate/80 hover:text-chocolate cursor-pointer">
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    class="rounded border-warm-border text-accent focus:ring-accent w-4 h-4"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                  >
                  <span class="{% if value.count == 0 and value.active == false %}opacity-40{% endif %}">
                    {{ value.label }}
                  </span>
                  <span class="text-[10px] text-chocolate/40 ml-auto font-mono">({{ value.count }})</span>
                </label>
              {%- endfor -%}
            </div>

          {%- when 'price_range' -%}
            <div class="flex items-center gap-2 text-xs">
              <div class="flex items-center border border-warm-border rounded-md px-2 py-1 bg-cream">
                <span class="text-chocolate/50 mr-1">$</span>
                <input
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                  placeholder="0"
                  class="w-14 bg-transparent text-chocolate focus:outline-none"
                >
              </div>
              <span class="text-chocolate/50">to</span>
              <div class="flex items-center border border-warm-border rounded-md px-2 py-1 bg-cream">
                <span class="text-chocolate/50 mr-1">$</span>
                <input
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                  placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                  class="w-14 bg-transparent text-chocolate focus:outline-none"
                >
              </div>
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}

    <!-- Sort By Field -->
    <div class="pt-2">
      <label for="SortBy" class="block font-serif text-base font-bold text-chocolate mb-2">
        Sort Treats By
      </label>
      <select
        name="sort_by"
        id="SortBy"
        class="w-full bg-cream border border-warm-border rounded-lg text-xs font-semibold text-chocolate p-2.5 focus:outline-none focus:border-accent"
      >
        {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
        {%- for option in results.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>
    </div>

  </div>
</form>
